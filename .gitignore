# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Session artifacts (audio is large and may contain voice data)
artifacts/
sessions/
*.wav
*.mp3
*.ogg

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Dry-run placeholders
results/audio/*.txt

# Generated audio is not committed: it is large, binary, and reproducible
# from the scripts. The results JSON summary is the committed proof instead.

# Operator-private material. The real protection is that this belongs OUTSIDE
# the repository entirely (see harness/private_config.py) -- these rules are the
# second line of defence for the case where it ends up here anyway.
private/
*.private.*
*.private
rules.local.json
prompts/
agent_config.json

# Session records. Regenerated by every run and noisy in a diff; one curated
# example is committed under examples/ instead.
results/transcripts/*.json
results/metrics/*.json
results/metrics/*.csv
