# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Nothing here is needed to run the harness offline. The loopback transport
# simulates an agent in-process with no server, no key and no account:
#
#     python harness/run_benchmark.py --mode audio --transport loopback
#
# These values are only for driving a real agent in a real room.

# --- Media server --------------------------------------------------------
# Prefer a locally run dev server: no hosted project, no account, throwaway
# credentials. `livekit-server --dev` serves exactly these defaults.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Substring identifying the agent among the room's participants. Leave empty in
# a room containing only the harness and one agent, which is the normal case.
HARNESS_AGENT_IDENTITY=

# --- Model providers -----------------------------------------------------
# Only needed with --tts, which renders real speech instead of shaped tones.
# Nothing else in the harness requires a model provider.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# A note on whose key to use, since it is easy to get wrong and awkward to
# undo. A key issued by an employer bills that employer and appears on their
# usage dashboards, attributed to whoever the key belongs to. Using one here
# puts this project's traffic on those records. That may be entirely fine if
# the work is sanctioned and the harness is being pointed at that employer's
# own agent -- it is their agent and their bill. It is worth being deliberate
# about rather than incidental, because the usage is indistinguishable after
# the fact. A personal key keeps the two separate with no argument required.

# --- Private configuration -----------------------------------------------
# Where operator-private material lives: behavioural rules, internal settings,
# anything confidential. It defaults to ~/.duplex-harness, deliberately OUTSIDE
# this repository, so such files are never in the working tree at all rather
# than relying on .gitignore to catch them. See harness/private_config.py.
# DUPLEX_HARNESS_PRIVATE_DIR=
