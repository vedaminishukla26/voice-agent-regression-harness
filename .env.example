# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# EVERY key here must come from a PERSONAL account.
# Using a JobTwine key would put this project's usage on company billing
# and dashboards — that is the exact traceability we are avoiding.
# See INFRA.md.

# --- LiveKit (prefer the LOCAL dev server; these are throwaway dev defaults) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Model providers (personal accounts only) ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
